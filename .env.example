# EmailJS (optional — FormSubmit fallback works without these)
# Sign up at https://www.emailjs.com and create a service + template
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Admin page password (default: codexpulse-admin)
# Access at /admin — not visible in public navigation
VITE_ADMIN_PASSWORD=codexpulse-admin
