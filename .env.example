# ==============================================================================
# CodeXPulse Production Configuration
# ==============================================================================

# Contact Form Recipient (Defaults to codexpulse.dev@gmail.com)
CONTACT_EMAIL=codexpulse.dev@gmail.com

# ------------------------------------------------------------------------------
# Option 1: Resend (Recommended for Vercel)
# Get a free API key at https://resend.com (3,000 emails/month free)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=CodeXPulse Contact <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# Option 2: Standard SMTP / Gmail App Password
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=CodeXPulse Contact <your_email@gmail.com>
